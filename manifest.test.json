{
  "manifest_version": 3,
  "name": "ZYouTube — AI Özet (Test)",
  "version": "1.1.0-test",
  "description": "YouTube videoları için Gemini Gem ve AI destekli özetleme eklentisi (test build).",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "activeTab",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://gemini.google.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*",
        "http://localhost:3000/*"
      ],
      "js": ["src/content/caption-network-hook.ts"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.youtube.com/*",
        "http://localhost:3000/*"
      ],
      "js": ["src/content/index.tsx"]
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": ["src/content/gemini/gemini-content-script.ts"]
    }
  ]
}
