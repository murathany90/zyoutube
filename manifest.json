{
  "manifest_version": 3,
  "name": "ZYouTube AI",
  "version": "1.1.0",
  "description": "YouTube videoları için AI destekli transkript, düzeltme, özet ve geçmiş eklentisi.",
  "icons": {
    "16": "icons/zyoutube-ai-16.png",
    "32": "icons/zyoutube-ai-32.png",
    "48": "icons/zyoutube-ai-48.png",
    "128": "icons/zyoutube-ai-128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "activeTab",
    "clipboardWrite",
    "offscreen"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://gemini.google.com/*",
    "https://api.dictionaryapi.dev/*",
    "https://api.datamuse.com/*",
    "https://api.mymemory.translated.net/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "action": {
    "default_title": "ZYouTube AI",
    "default_icon": {
      "16": "icons/zyoutube-ai-16.png",
      "32": "icons/zyoutube-ai-32.png",
      "48": "icons/zyoutube-ai-48.png",
      "128": "icons/zyoutube-ai-128.png"
    },
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*"
      ],
      "js": ["src/content/caption-network-hook.ts"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.youtube.com/*"
      ],
      "js": ["src/content/index.tsx"]
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": ["src/content/gemini/gemini-content-script.ts"]
    }
  ]
}
